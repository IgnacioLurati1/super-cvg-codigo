# Solo para npm run test:flujos: un cliente de Google de prueba, así Classroom aparece con Google simulado.
VITE_GOOGLE_CLIENTE=cliente-de-prueba.apps.googleusercontent.com
# Y una clave de Drive de prueba: los flujos simulan las carpetas públicas de Drive.
VITE_DRIVE_CLAVE=clave-de-drive-de-prueba
